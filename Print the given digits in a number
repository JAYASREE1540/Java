/*✅ Algorithm: Print Digits in Correct Order (Without String)
Start
Input number n
Set temp = n
Set reverse = 0
🔁 Step 1: Reverse the Number
Repeat while temp > 0:
digit = temp % 10
reverse = reverse * 10 + digit
temp = temp / 10
🔁 Step 2: Print Digits in Correct Order
Repeat while reverse > 0:
digit = reverse % 10
Print digit
reverse = reverse / 10 
*/
import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        System.out.print("Enter a number: ");
        int y=sc.nextInt();
        int temp=y;
        int rev=0;
        int dig;
        while(temp>0){
            dig=temp%10;
            rev=rev*10+dig;
            temp=temp/10;
        }
        while(rev>0){
            dig=rev%10;
            System.out.print(dig);
            rev=rev/10;
        }
    }
}
