/*✅ Algorithm: Print All Prime Numbers up to n
Start
Input number n
For each number i from 2 to n:
Set count = 0
Check if i is prime:
For each number j from 1 to i:
If i % j == 0
Increment count
After checking all j:
If count == 2
Print i (it is a prime number)
Repeat steps for next i
Stop*/
import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        System.out.print("Enter a number up to : ");
        int y=sc.nextInt();
        for(int i=2;i<=y;i++)
        {
              int count=0;
              for(int j=1;j<=i;j++)
              {
                if(i%j==0)
                {
                    count++;
                }
                  
              }
              if(count==2)
              {
                  System.out.println(i);
              }
        }
    }
}
                
