/*✅ Algorithm (Step-by-Step)
Start
Input number n
Set count = 0
Repeat while n > 0:
n = n / 10
count = count + 1
Print count
Stop*/
import java.util.Scanner;
public class Main{
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    System.out.print("Enter a number: ");
    int a=sc.nextInt();
    int count=0;
    while(a!=0)
    {
      a=a/10;
      count++;
    }
    System.out.print(a);
  }
}
